*{box-sizing:border-box}body{margin:0;font:16px/1.5 Arial,sans-serif;color:#252525;background:#f7f7f7}header{background:white;border-bottom:1px solid #ddd;padding:18px max(18px,calc((100vw - 1150px)/2));display:flex;justify-content:space-between;align-items:center;gap:20px}header img{width:165px;max-width:50%}header span{font-size:12px;color:#777}main{max-width:1150px;padding:32px 18px;margin:auto}h1{font-size:clamp(28px,4vw,42px)}.filtros{background:white;padding:20px;border:1px solid #ddd;border-radius:12px;display:grid;grid-template-columns:2fr repeat(3,1fr) auto;gap:12px;align-items:end;margin:28px 0}label{display:flex;flex-direction:column;font-weight:600;font-size:14px;gap:7px}input,select{min-width:0;padding:12px;border:1px solid #bbb;border-radius:6px;font:inherit;background:white}button{border:0;background:#be1e2d;color:white;padding:13px 18px;cursor:pointer;border-radius:6px;font-weight:600}button:hover{background:#931522}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #225bad;outline-offset:3px}.grade{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px}.grade article{background:white;border-radius:12px;overflow:hidden;border:1px solid #ddd;display:flex;flex-direction:column}.grade article>img{width:100%;height:170px;object-fit:cover}.corpo{padding:18px;display:flex;flex-direction:column;flex:1}.corpo h2{font-size:19px}.corpo p{flex:1}.corpo button{align-self:start}.detalhe{background:white;border:1px solid #ddd;padding:24px;border-radius:12px;margin:24px 0}.erro{color:#9d1020}footer{text-align:center;padding:25px;background:#222;color:white;margin-top:48px}@media(max-width:900px){.filtros{grid-template-columns:repeat(2,1fr)}.grade{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.filtros,.grade{grid-template-columns:1fr}header span{display:none}main{padding:20px 14px}}
